{
  "pages": [
    { "path": "pages/login/login", "style": { "navigationStyle": "custom" } },
    { "path": "pages/register/register", "style": { "navigationStyle": "custom" } },
    {
      "path": "pages/home/home",
      "style": { "navigationBarTitleText": "首页", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/courses/courses",
      "style": { "navigationBarTitleText": "课程", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/schedule/schedule",
      "style": { "navigationBarTitleText": "日程", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/messages/messages",
      "style": { "navigationBarTitleText": "消息", "enablePullDownRefresh": true }
    },
    { "path": "pages/mine/mine", "style": { "navigationBarTitleText": "我的" } },
    { "path": "pages/person/person", "style": { "navigationBarTitleText": "个人资料" } },
    { "path": "pages/password/password", "style": { "navigationBarTitleText": "修改密码" } }
  ],
  "subPackages": [
    {
      "root": "pages-course",
      "pages": [
        {
          "path": "space/space",
          "style": { "navigationBarTitleText": "课程", "enablePullDownRefresh": true }
        },
        {
          "path": "assignment/assignment",
          "style": { "navigationBarTitleText": "作业", "enablePullDownRefresh": true }
        },
        {
          "path": "square/square",
          "style": { "navigationBarTitleText": "选课广场", "enablePullDownRefresh": true }
        },
        {
          "path": "transcript/transcript",
          "style": { "navigationBarTitleText": "成绩单", "enablePullDownRefresh": true }
        }
      ]
    },
    {
      "root": "pages-admin",
      "pages": [
        {
          "path": "courses/courses",
          "style": { "navigationBarTitleText": "课程管理", "enablePullDownRefresh": true }
        },
        { "path": "course-form/course-form", "style": { "navigationBarTitleText": "开课" } },
        {
          "path": "rooms/rooms",
          "style": { "navigationBarTitleText": "教室", "enablePullDownRefresh": true }
        },
        {
          "path": "leaves/leaves",
          "style": { "navigationBarTitleText": "请假审批", "enablePullDownRefresh": true }
        },
        {
          "path": "exams/exams",
          "style": { "navigationBarTitleText": "考试安排", "enablePullDownRefresh": true }
        },
        {
          "path": "warnings/warnings",
          "style": { "navigationBarTitleText": "学业预警", "enablePullDownRefresh": true }
        },
        {
          "path": "org/org",
          "style": { "navigationBarTitleText": "组织架构", "enablePullDownRefresh": true }
        },
        {
          "path": "people/people",
          "style": { "navigationBarTitleText": "人员", "enablePullDownRefresh": true }
        },
        { "path": "semester/semester", "style": { "navigationBarTitleText": "学期设置" } }
      ]
    }
  ],
  "preloadRule": {
    "pages/courses/courses": { "network": "all", "packages": ["pages-course"] },
    "pages/schedule/schedule": { "network": "all", "packages": ["pages-admin"] }
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-on.png"
      },
      {
        "pagePath": "pages/courses/courses",
        "text": "课程",
        "iconPath": "static/tabbar/courses.png",
        "selectedIconPath": "static/tabbar/courses-on.png"
      },
      {
        "pagePath": "pages/schedule/schedule",
        "text": "日程",
        "iconPath": "static/tabbar/schedule.png",
        "selectedIconPath": "static/tabbar/schedule-on.png"
      },
      {
        "pagePath": "pages/messages/messages",
        "text": "消息",
        "iconPath": "static/tabbar/messages.png",
        "selectedIconPath": "static/tabbar/messages-on.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-on.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "@navTextStyle",
    "navigationBarTitleText": "教务管理系统",
    "navigationBarBackgroundColor": "@navBgColor",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTextStyle",
    "enablePullDownRefresh": false
  }
}
